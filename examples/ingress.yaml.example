# Copy this file to an environment-specific overlay and replace every placeholder.
# Do not add a real hostname, issuer name, or middleware reference to the base repository.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: open-webui
  namespace: ollama
  annotations:
    kubernetes.io/ingress.class: <your-ingress-class>
spec:
  rules:
    - host: ai.example.invalid
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: svc-open-webui
                port:
                  number: 8080
